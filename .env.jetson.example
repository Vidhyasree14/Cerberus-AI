# ── EdgeVision Jetson Production Environment Configuration ──

# Model Path (TensorRT .engine is recommended for max Jetson FPS)
MODEL_PATH=models/best.engine
FALLBACK_MODEL_PATH=models/best.pt

# Performance Profile: "high_end" enables CUDA & Tensor Core acceleration
PERFORMANCE_PROFILE=high_end
INFERENCE_HALF_PRECISION=true
INFERENCE_IMG_SIZE=640
FRAME_SKIP_INTERVAL=0

# Detection & Tracking Thresholds
DETECTION_CONF=0.35
ZONE_DETECTION_CONF=0.35

# Video Input Source (0 for CSI/USB camera, or RTSP stream URL)
CAMERA_SOURCE=0

# Database Engine (sqlite or mongodb)
DB_ENGINE=sqlite

# MQTT Violation Alerting (Optional)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=factory/ppe_violations
